# Thursday configuration. Copy to .env and adjust. Nothing here reaches for the cloud
# by default: a fresh checkout runs fully local (§58).

THURSDAY_OWNER_NAME=Owner
THURSDAY_LOCALE=th-TH
THURSDAY_TIMEZONE=Asia/Bangkok
THURSDAY_PROACTIVITY=2   # when Thursday may SPEAK unprompted: 0 off · 1 low · 2 normal · 3 high
THURSDAY_AUTONOMY=2      # when Thursday may ACT unasked:  0 suggest · 1 safe · 2 moderate · 3 high

THURSDAY_HOST=127.0.0.1
THURSDAY_PORT=8000
THURSDAY_LOG_LEVEL=INFO
THURSDAY_LOG_JSON=false

# The database URL is composed from parts so no password lands in a tracked file.
# Development default is SQLite (settings.yaml); production is Postgres + pgvector.
# THURSDAY_DB_DRIVER=postgresql+asyncpg
# THURSDAY_DB_HOST=localhost
# THURSDAY_DB_NAME=thursday
# THURSDAY_DB_USER=thursday
# THURSDAY_DB_PASSWORD=change-me
#
# Or override the whole thing at once (a managed database, say):
# THURSDAY_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/thursday
#
# Absent ⇒ in-process event bus and queue, which is what the tests use.
# THURSDAY_REDIS_URL=redis://localhost:6379/0

# rule (offline, deterministic) · ollama (local model) · anthropic (cloud)
THURSDAY_LLM_BACKEND=rule
THURSDAY_ALLOW_CLOUD=true
THURSDAY_OLLAMA_URL=http://127.0.0.1:11434
THURSDAY_OLLAMA_MODEL=llama3.1:8b

# Credentials live in the vault, never in this file and never in a prompt.
# With the env vault, the handle "anthropic_api_key" reads THURSDAY_SECRET_ANTHROPIC_API_KEY.
THURSDAY_VAULT_BACKEND=env
# THURSDAY_SECRET_ANTHROPIC_API_KEY=...

THURSDAY_WAKE_WORD=thursday
THURSDAY_STT_BACKEND=stub             # stub | whisper
THURSDAY_TTS_BACKEND=stub             # stub | piper

THURSDAY_OBSIDIAN_ENABLED=true
THURSDAY_OBSIDIAN_VAULT=thursday_vault
THURSDAY_EMBEDDING_BACKEND=hash       # hash (offline) | ollama

THURSDAY_DEFAULT_TASK_BUDGET_USD=0.50
THURSDAY_APPROVAL_TTL_SECONDS=300
THURSDAY_REQUIRE_DEVICE_SIGNATURE=true

# --- device nodes ------------------------------------------------------------
# The enrolment token. The core refuses an unsigned or wrongly-signed HELLO in every
# environment (ADR 0013), so the same value must be set on the core and on every node.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# THURSDAY_SECRET_DEVICE_ENROLLMENT_SECRET=

# Where the node dials, and its own loopback diagnostics listener.
# THURSDAY_CORE_URL=ws://127.0.0.1:8000/api/v1/device
# THURSDAY_DEVICE_NAME=Office-PC
# THURSDAY_NODE_HOST=127.0.0.1
# THURSDAY_NODE_PORT=8765
